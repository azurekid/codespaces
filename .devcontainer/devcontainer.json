{
  "name": "BlackCat",
  "image": "mcr.microsoft.com/azure-powershell:latest",
  "customizations": {
    "vscode": {
      "settings": {
        "debug.javascript.terminal.activateWithCurrentFile": false,
        "debug.javascript.autoAttachFilter": "disabled",
        "debug.javascript.automaticallyTunnelRemoteServer": false,
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "BlackCat": {
            "path": "/opt/microsoft/powershell/7/pwsh",
            "icon": "terminal-powershell"
          }
        },
        "terminal.integrated.defaultProfile.linux": "BlackCat"
      },
      "extensions": [
        "ms-vscode.powershell",
        "ms-azuretools.vscode-bicep",
        "GitHub.copilot",
        "shardulm94.trailing-spaces",
        "GitHub.vscode-github-actions",
        "DavidAnson.vscode-markdownlint",
        "ms-vscode.vscode-node-azure-pack",
        "ms-azuretools.vscode-azureterraform",
        "ms-azuretools.vscode-azurerm-vscode-tools",
        "ms-azuretools.vscode-azuresecurity"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": "false",
      "username": "vscode",
      "upgradePackages": "true",
      "nonFreePackages": "false"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": "true",
      "installUsingPython": "true"
    }
  },
  "postCreateCommand": "mkdir /root/.config/powershell && echo 'Import-Module -Name ./src/BlackCat.psd1' > /root/.config/powershell/Microsoft.PowerShell_profile.ps1 && ./.devcontainer/update.sh && Export-AccessTokens && Install-Module -Name AzSK -Scope CurrentUser -AllowClobber -Force && az extension add --name security"
}
